{
  "data": {
    "path_file": "paths.txt",
    "hist_sec": 2.0,
    "fut_sec": 6.0,
    "sample_freq": 2.0,
    "relative_coords": true,
    "align_heading": true,
    "coord_scale": 10.0,
    "window_stride": 2,
    "val_ratio": 0.2,
    "split_seed": 42,
    "num_workers": 0,
    "keep_empty_instruction": true,
    "rebalance_non_empty_instruction": true,
    "non_empty_instruction_weight": 2.5
  },
  "model": {
    "text_model_name": "../models/distilbert-base-uncased",
    "hidden_dim": 256,
    "pred_steps": 12,
    "freeze_text_encoder": true,
    "text_unfreeze_last_n_layers": 2,
    "local_files_only": true,
    "attention_heads": 4
  },
  "training": {
    "run_name": "baseline",
    "epochs": 5,
    "batch_size": 8,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 0.0,
    "checkpoint_dir": "artifacts/checkpoints",
    "checkpoint_name": "baseline_best.pth",
    "report_dir": "artifacts/experiments",
    "early_stop_patience": 3,
    "early_stop_min_delta": 0.0,
    "baseline_head_loss_weight": 1.0,
    "rank_loss_weight": 0.7,
    "rank_margin": 0.02
  },
  "runtime": {
    "seed": 42,
    "device": "auto",
    "gpu_max_util": 0.8,
    "gpu_poll_sec": 0.5
  }
}
