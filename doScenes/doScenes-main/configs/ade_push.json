{
  "data": {
    "path_file": "paths.txt",
    "hist_sec": 2.0,
    "fut_sec": 6.0,
    "sample_freq": 2.0,
    "relative_coords": true,
    "align_heading": true,
    "coord_scale": 10.0,
    "window_stride": 1,
    "val_ratio": 0.2,
    "split_seed": 42,
    "num_workers": 0,
    "pin_memory": false,
    "persistent_workers": false,
    "keep_empty_instruction": false,
    "rebalance_non_empty_instruction": false,
    "non_empty_instruction_weight": 1.0
  },
  "model": {
    "text_model_name": "../models/distilbert-base-uncased",
    "hidden_dim": 192,
    "pred_steps": 12,
    "freeze_text_encoder": true,
    "text_unfreeze_last_n_layers": 2,
    "local_files_only": true,
    "attention_heads": 2
  },
  "training": {
    "run_name": "ade_push",
    "epochs": 8,
    "batch_size": 12,
    "lr": 0.00005,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "checkpoint_dir": "artifacts/checkpoints",
    "checkpoint_name": "ade_push_best.pth",
    "report_dir": "artifacts/experiments",
    "early_stop_patience": 4,
    "early_stop_min_delta": 0.0,
    "eval_every_n_epochs": 1,
    "baseline_head_loss_weight": 0.0,
    "rank_loss_weight": 0.0,
    "rank_margin": 0.0,
    "fde_loss_weight": 0.002,
    "init_checkpoint": "artifacts/checkpoints/ade_finetune_best.pth"
  },
  "runtime": {
    "seed": 42,
    "device": "auto",
    "gpu_max_util": 0.8,
    "gpu_poll_sec": 0.5,
    "amp": true,
    "matmul_precision": "high"
  }
}
